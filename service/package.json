{
  "name": "@apps/auspex",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Auspex's service: its API behind the gateway at /api/auspex.",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp ../manifest.json dist/manifest.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@augur/service-kit": "workspace:*",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
